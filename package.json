{
  "name": "voy-mobile-svelte",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src worker tests browser-tests scripts/build-static-manifest.mjs scripts/check-bundle-budgets.mjs scripts/svelte-candidate-gate.mjs scripts/svelte-candidate-api-gate.mjs vite.config.ts",
    "test": "bun test tests __tests__/analyticsOptOut.test.js __tests__/analyticsOptOutBoundary.test.js __tests__/authSession.test.js __tests__/coordinatorAlarmPagination.test.js __tests__/destinationResolution.test.js __tests__/geocodeWorker.test.js __tests__/nominatimCoordinator.test.js __tests__/releasePolicy.test.js __tests__/securityBoundary.test.js __tests__/strictCoordinates.test.js __tests__/voiceCopilotApi.test.js __tests__/voiceCopilotContracts.test.js __tests__/voiceCopilotProviders.test.js __tests__/voiceCopilotRuntime.test.js __tests__/voiceCopilotSelection.test.js",
    "test:browser": "playwright test -c browser-tests/playwright.config.ts",
    "budget": "node scripts/check-bundle-budgets.mjs",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run build && bun run budget"
  },
  "dependencies": {
    "maplibre-gl": "4.7.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "latest",
    "@types/geojson": "latest",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "wrangler": "4.112.0"
  }
}
