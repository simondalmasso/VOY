{
  "name": "voy-mobile-svelte",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src worker tests browser-tests scripts/build-static-manifest.mjs scripts/check-bundle-budgets.mjs scripts/run-test-inventory.mjs scripts/verify-production-assets.mjs scripts/verify-retired-candidate-assets.mjs scripts/verify-santa-fe-transit-handoff.mjs vite.config.ts",
    "assets:source": "node scripts/verify-production-assets.mjs --source-only",
    "assets:build": "node scripts/verify-production-assets.mjs --build-only",
    "test": "node scripts/run-test-inventory.mjs",
    "test:browser": "playwright test -c browser-tests/playwright.config.ts",
    "verify:transit-source": "node scripts/verify-santa-fe-transit-handoff.mjs",
    "budget": "node scripts/check-bundle-budgets.mjs",
    "validate": "bun run typecheck && bun run lint && bun run assets:source && bun run test && bun run build && bun run assets:build && bun run budget"
  },
  "dependencies": {
    "maplibre-gl": "4.7.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "latest",
    "@types/geojson": "latest",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "wrangler": "4.112.0"
  }
}
