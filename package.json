{
  "name": "voy-mobile-svelte",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src worker tests __tests__ browser-tests scripts/build-static-manifest.mjs scripts/check-bundle-budgets.mjs vite.config.ts",
    "test": "bun test tests/*.test.ts __tests__/*.test.js",
    "test:browser": "playwright test -c browser-tests/playwright.config.ts",
    "budget": "node scripts/check-bundle-budgets.mjs",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run build && bun run budget"
  },
  "dependencies": {
    "maplibre-gl": "4.7.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "1.3.14",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "16.5.0",
    "svelte-check": "4.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "wrangler": "4.112.0"
  }
}
