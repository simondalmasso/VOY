{
  "name": "voy",
  "version": "0.1.0",
  "description": "Truth-first, map-first mobility surface for Argentina.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simondalmasso/VOY.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "test": "node --test tests/*.test.mjs",
    "generate:rail-catalog": "node --use-system-ca scripts/generate-rail-station-catalog.mjs",
    "build:linux": "bash scripts/build.sh",
    "build:mapfirst": "bash scripts/build.sh"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright-core": "1.55.0",
    "wrangler": "4.125.0"
  }
}
