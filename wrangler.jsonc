{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voy-app",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROUTING_COORDINATOR", "class_name": "NominatimCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1_nominatim_coordinator", "new_sqlite_classes": ["NominatimCoordinator"] }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
