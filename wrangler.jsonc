{
  // ============================================================
  //  VOY Lite — Cloudflare Workers config
  //  Sirve public/ como assets estáticos + rewrite / → /VOY-Lite.html
  // ============================================================
  "name": "voy-app",
  "compatibility_date": "2026-06-22",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
